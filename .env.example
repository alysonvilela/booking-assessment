# Copy to .env and adjust per environment.

NODE_ENV=development
API_PORT=3000
WEB_ORIGINS=http://localhost:3001

# No database: `file` (JSON on disk, survives restarts) or `memory`.
STORE_DRIVER=file
STORE_FILE=./data/bookings.json

# First wait after a send (= ack timeout); doubles per attempt up to the max.
DELIVERY_ACK_TIMEOUT_MS=2000
DELIVERY_MAX_BACKOFF_MS=30000
# Failover order: each attempt uses the first channel that takes the message.
DELIVERY_CHANNELS=push,webhook,email

OTEL_SERVICE_NAME=pentice-api
OTEL_EXPORTER_OTLP_ENDPOINT=
